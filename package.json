{
  "name": "drift-browser",
  "productName": "Drift",
  "version": "0.1.1",
  "description": "Drift - Browse light.",
  "main": "./out/main/index.js",
  "author": "l7v0l",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "assets": "node scripts/build-assets.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "homepage": "https://github.com/l7v0l/drift-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7v0l/drift-browser.git"
  },
  "bugs": {
    "url": "https://github.com/l7v0l/drift-browser/issues"
  },
  "keywords": [
